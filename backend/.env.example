# Modèle de configuration — copier en backend/.env et renseigner les vraies valeurs.
# Le fichier .env réel ne doit JAMAIS être commité (voir .gitignore).
#
# Le code refuse désormais de démarrer si DB_HOST, DB_USER, DB_PASS, DB_NAME
# ou JWT_SECRET sont absents : il n'y a plus aucune valeur de repli en dur.

PORT=5000

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=NetSecureManager

# Chaîne longue et aléatoire, propre à chaque environnement.
JWT_SECRET=

# Adresse(s) autorisée(s) à appeler l'API depuis un navigateur.
# Plusieurs adresses se séparent par des virgules, sans barre finale.
#
# Laissé vide, seules les adresses locales de développement sont
# acceptées, et un avertissement s'affiche au démarrage. À renseigner
# avant toute mise en service : sans cela, aucune page servie depuis une
# autre adresse ne pourra charger l'interface.
#
# Exemple : FRONTEND_URL=https://supervision.societe.fr,http://192.168.0.10:5173
FRONTEND_URL=

# Temps réel — rafraîchissement de l'interface sans rechargement.
# Laissé vide, la plateforme fonctionne normalement mais l'utilisateur
# doit recharger la page pour voir une nouvelle alerte.
# Mettre l'adresse EXACTE de l'interface, comme pour FRONTEND_URL.
WEBSOCKET_ORIGINE=http://localhost:5173

# Nombre de machines identifiées EN PARALLÈLE pendant un scan.
# Laissé vide : 10. C'est le réglage qui décide de la durée d'un scan —
# nmap représente 93 % du temps, et ce nombre dit combien tournent à la
# fois. Doubler la valeur divise à peu près la durée par deux.
#   10  → discret, convient à un réseau de production en journée
#   16-24 → nettement plus rapide ; à réserver aux réseaux sans sonde
#           d'intrusion, ou aux scans de nuit
# Plafonné à 32.
SCAN_CONCURRENCE=

# Nombre d'adresses pinguées en parallèle pendant le balayage initial.
# Laissé vide : 64. Le ping est bien moins coûteux que l'identification ;
# ce réglage n'a d'effet visible que sur les très grandes plages.
PING_CONCURRENCE=

# Nombre maximal d'adresses qu'une plage de scan a le droit de contenir.
# Laissé vide : 65534, soit un /16. Au-delà, le scan est refusé avec un
# message explicite plutôt que de consommer toute la mémoire du serveur —
# « 10.0.0.0/8 » saisi à la place de « 10.0.0.0/24 » est une faute courante.
SCAN_MAX_HOTES=

# ── FRONTEND ──────────────────────────────────────────────────────────
# L'interface se construit avec l'adresse de l'API FIGÉE DEDANS : la
# variable est lue à la compilation, pas à l'exécution. Un « npm run build »
# lancé sans elle produit une interface qui appellera http://localhost:5000
# depuis le poste de chaque utilisateur — c'est-à-dire rien.
#
# À renseigner dans frontend/.env AVANT de compiler :
#   VITE_API_URL=https://supervision.societe.fr/api
# ──────────────────────────────────────────────────────────────────────

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=alertes@example.com
